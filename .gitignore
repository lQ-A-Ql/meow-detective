# Artifact drop zones may contain copied workstation evidence. Keep only their
# reviewed metadata contracts in Git; public binary fixtures belong under the
# explicitly governed public-small/public-medium trees.
/testdata/artifacts/**/*
!/testdata/artifacts/**/
!/testdata/artifacts/**/README.md
!/testdata/artifacts/**/expected.json
!/testdata/artifacts/**/.gitkeep
# These public-medium directories currently contain specifications only. A
# reviewed fixture must be explicitly unignored together with its provenance.
/testdata/fixtures/public-medium/browser/**/*
!/testdata/fixtures/public-medium/browser/README.md
/testdata/fixtures/public-medium/linux/**/*
!/testdata/fixtures/public-medium/linux/README.md
/crates/app-services/output/
/output/
/development-reports/
AGENTS.md
*.log
/*.md
!/README.md
*.bat

# Documentation retention policy
# Keep durable support, protocol, security, validation, and dependency-policy
# contracts in Git. Architecture, module design, development plans, stage
# reports, real-sample runs, benchmark outputs, walkthroughs, and editor state
# remain workstation-local.
/docs/**
!/docs/benchmark-baseline.md
!/docs/bitlocker-dependency-decision.md
!/docs/dependency-advisory-policy.md
!/docs/dependency-decisions.md
!/docs/documentation-index.md
!/docs/error-classification-manual.md
!/docs/error-taxonomy.md
!/docs/evtx-dependency-decision.md
!/docs/expected-json-contract.md
!/docs/export-and-media-safety.md
!/docs/ipc-event-contract.md
!/docs/known-unsupported-formats.md
!/docs/mcp-security-model.md
!/docs/parser-support-matrix.md
!/docs/pst-ost-mbox-support.md
!/docs/validation-trust-framework.md

