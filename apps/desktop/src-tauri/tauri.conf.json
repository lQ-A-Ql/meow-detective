{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forensics Workbench",
  "version": "0.1.0",
  "identifier": "com.lqaq.forensics",
  "build": {
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forensics Workbench",
        "width": 1440,
        "height": 960
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
