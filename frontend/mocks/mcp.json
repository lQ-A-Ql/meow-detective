{
  "config": {
    "servers": [
      { "id": "mcp-local-forensics", "name": "本地取证工具", "transport_type": "stdio", "command": "meow-mcp-local", "args": ["--case", "case-mock-001"], "enabled": true, "auto_connect": false,
        "permissions": { "resource_access": "readOnly", "tool_access": "allowAll", "prompt_access": "readOnly", "network_policy": "localhostOnly", "allowed_tools": [], "denied_tools": [], "allowed_commands": [] } },
      { "id": "mcp-threat-intel", "name": "威胁情报查询", "transport_type": "sse", "url": "http://127.0.0.1:3010/sse", "enabled": false, "auto_connect": false,
        "permissions": { "resource_access": "readOnly", "tool_access": "disabled", "prompt_access": "readOnly", "network_policy": "localhostOnly", "allowed_tools": [], "denied_tools": [], "allowed_commands": [] } }
    ], "resources": {}, "tools": {}
  },
  "host": { "settings": { "enabled": true, "disabledTools": [] }, "running": true, "endpoint": "http://127.0.0.1:3001/mcp" },
  "tools": [
    { "name": "listDataSources", "description": "列出当前案件的数据源与导入状态", "inputSchema": { "type": "object", "properties": { "limit": { "type": "number", "default": 20 } } } },
    { "name": "searchFiles", "description": "在当前案件中查找文件", "inputSchema": { "type": "object", "properties": { "query": { "type": "string" } }, "required": ["query"] } },
    { "name": "queryTimeline", "description": "查询指定区间的案件时间线", "inputSchema": { "type": "object", "properties": { "limit": { "type": "number", "default": 50 } } } },
    { "name": "getCaseSummary", "description": "读取案件基本信息与证据统计", "inputSchema": { "type": "object", "properties": {} } }
  ],
  "resources": [
    { "uri": "forensics://case-mock-001/summary", "name": "案件摘要", "description": "当前模拟案件的基本信息" },
    { "uri": "forensics://case-mock-001/sources", "name": "数据源清单", "description": "已导入的模拟镜像与目录" }
  ]
}
