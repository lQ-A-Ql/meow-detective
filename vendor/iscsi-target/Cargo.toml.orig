[package]
name = "iscsi-target"
version = "1.0.0"
edition = "2021"
authors = ["Matt Lawless"]
license = "MIT OR Apache-2.0"
description = "A pure Rust iSCSI target implementation"
repository = "https://github.com/lawless-m/iscsi-crate"
keywords = ["iscsi", "storage", "scsi", "target", "network"]
categories = ["network-programming", "filesystem"]
readme = "README.md"
include = [
    "src/**",
    "examples/*.rs",
    "docs/**",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
]

[dependencies]
byteorder = "1.5"
thiserror = "1.0"
log = "0.4"
md5 = "0.7"
rand = "0.8"
hex = "0.4"
crc32c = "0.6"

[dev-dependencies]
env_logger = "0.11"
toml = "0.8"
once_cell = "1.19"

[lib]
name = "iscsi_target"
path = "src/lib.rs"

[[example]]
name = "simple_target"
path = "examples/simple_target.rs"

[[example]]
name = "chap_target"
path = "examples/chap_target.rs"

[[example]]
name = "mutual_chap_target"
path = "examples/mutual_chap_target.rs"
